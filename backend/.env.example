# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication (required; use unique values outside development)
AUTH_SECRET_KEY=replace_with_a_long_random_auth_secret
INITIAL_HOST_USERNAME=replace_with_host_username
INITIAL_HOST_PASSWORD=replace_with_host_password
INITIAL_HOST_NAME=CampusFix Administrator
INITIAL_HOST_EMAIL=admin@campusfix.edu
INITIAL_HOST_NETID=replace_with_host_username

# Email OTP provider. Development prints the generated email to the backend console only.
EMAIL_MODE=development
RESEND_API_KEY=
EMAIL_FROM=CampusFix.AI <verified-sender@example.com>

# Neon PostgreSQL Database Connection (sslmode=require)
DATABASE_URL=postgresql://neondb_owner:npg_samplepassword@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# AI Diagnostic Engine via OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

